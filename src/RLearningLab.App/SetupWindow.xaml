<Window x:Class="RLearningLab.App.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Setup &amp; tools — R Learning Lab" Width="780" Height="850" MinWidth="660" MinHeight="640" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="15" Foreground="#16343E" Background="#F4F7F6">
 <Border Background="#F4F7F6" Padding="28"><DockPanel>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Save &amp; return" Style="{StaticResource Primary}" Click="SaveClicked"/><Button Content="Close" Click="CloseClicked"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
   <TextBlock Text="Connect your learning tools" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <TextBlock Text="R does the calculations. RStudio is where you code. R Learning Lab guides your practice. Install R first, then RStudio Desktop. The companion does not bundle either tool." Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
   <WrapPanel><Button Content="Get R for Windows" Click="DownloadRClicked"/><Button Content="Get RStudio Desktop" Click="DownloadRStudioClicked"/><Button Content="Detect again" Click="DetectClicked"/></WrapPanel>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
    <TextBlock Text="1. Rscript.exe" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="Usually inside your R installation's bin folder. A custom path is welcome." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,8"/>
    <TextBox x:Name="RscriptPathBox" AutomationProperties.Name="Path to Rscript.exe"/>
    <WrapPanel Margin="0,8,0,0"><Button Content="Browse for Rscript.exe" Click="BrowseRClicked"/><Button Content="Check R version" Click="VersionClicked"/></WrapPanel>
    <TextBlock x:Name="RStatus" Foreground="#087E8B"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
    <TextBlock Text="2. RStudio Desktop" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBox x:Name="RStudioPathBox" AutomationProperties.Name="Path to rstudio.exe"/>
    <Button Content="Browse for rstudio.exe" Click="BrowseRStudioClicked" HorizontalAlignment="Left" Margin="0,8,0,8"/>
    <TextBlock x:Name="RStudioStatus" Foreground="#087E8B"/>
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="18"><StackPanel>
    <TextBlock Text="Your workspace and saved progress" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock x:Name="WorkspacePathText" FontSize="13" Foreground="{StaticResource Muted}"/>
    <TextBlock Text="Startup adds missing starter files and preserves existing edits. Before restoring a dataset, the app copies the current file into the project's Backups folder." FontSize="13" Foreground="{StaticResource Muted}" Margin="0,10,0,10"/>
    <WrapPanel><Button Content="Restore five-row dataset…" Click="ResetSmallClicked"/><Button Content="Restore extended dataset…" Click="ResetExtendedClicked"/></WrapPanel>
   </StackPanel></Border>
   <CheckBox x:Name="ExecutionAcknowledged"><TextBlock Text="I understand that Check My Work runs my saved R script with my Windows user's permissions. R code can read or change files. I will submit only code I knowingly choose to run." TextWrapping="Wrap"/></CheckBox>
   <TextBlock Text="A separate R process, --vanilla and a time limit do not provide a security sandbox. You can read lessons without enabling execution." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
   <TextBlock x:Name="SetupStatus" Foreground="#8B481B" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel></ScrollViewer>
 </DockPanel></Border>
</Window>
